# Copy to .env and fill in real values. Never commit .env.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Brevo (used by Supabase Edge Functions send-otp / send-email; set as function secrets too)
VITE_BREVO_API_KEY=YOUR_BREVO_API_KEY
VITE_SENDER_EMAIL=noreply@example.com

# ImgBB (https://api.imgbb.com) — get a free API key at https://api.imgbb.com
VITE_IMGBB_API_KEY=YOUR_IMGBB_API_KEY

# Admin panel login (used by the /admin page; not stored in any database)
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
